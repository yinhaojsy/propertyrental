# Database (Homebrew PostgreSQL 18 — replace YOUR_USERNAME with your macOS username)
DATABASE_URL=postgresql://YOUR_USERNAME@localhost:5432/property_rental

# Redis (Homebrew: brew install redis && brew services start redis)
REDIS_URL=redis://localhost:6379

# JWT (access token rotates every ~15m while you stay active)
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Session ends after this much inactivity (milliseconds). Default: 1 hour
SESSION_INACTIVITY_MS=3600000

# Bootstrap admin (created on first seed if not exists)
BOOTSTRAP_ADMIN_EMAIL=admin@test.com
BOOTSTRAP_ADMIN_PASSWORD=admin123

# Storage — local dev uses apps/api/uploads/ automatically if MinIO is not running
# Set USE_LOCAL_STORAGE=true to force local disk storage (e.g. Railway volume)
USE_LOCAL_STORAGE=
# UPLOADS_DIR=/data/uploads   # Railway: mount volume here
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=property-rental
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_URL=http://127.0.0.1:9000/property-rental

# API
PORT=3000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
# API_PUBLIC_URL=https://your-api.up.railway.app   # required for local storage photo URLs in production

# Email (optional for offer notifications)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=

# Web (Vite)
VITE_API_URL=http://localhost:3000
